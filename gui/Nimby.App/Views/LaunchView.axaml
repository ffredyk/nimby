<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nimby.App.Views.LaunchView">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="4">

        <Border Grid.Row="0" Classes="card">
            <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="Launch" />
                    <TextBlock x:Name="ArmaText" Classes="muted" FontSize="11" Text="" />
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="ServerBox" VerticalAlignment="Center"
                          PlaceholderText="No server" />
                <Button Grid.Column="2" x:Name="PreviewButton" Content="Preview" Click="OnPreview"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <CheckBox x:Name="BattleyeBox" Content="Launch with BattlEye" />
                <TextBlock x:Name="ParamsText" Classes="muted" FontSize="11" Text="" />
                <TextBlock x:Name="StoreText" Classes="muted" FontSize="11" Text="" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Classes="muted" FontSize="11"
                           Text="Command line preview (password redacted)" Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock x:Name="CommandText" Classes="mono" TextWrapping="Wrap" Text="" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <Button x:Name="LaunchButton" Classes="accent" Content="Launch Arma 3" Click="OnLaunch" />
            <TextBlock x:Name="StatusLine" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
